# BioVeracity environment template — copy to .env and fill in real values locally.
# NEVER commit the real .env (it is gitignored).

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# Abacus.AI platform APIs (LLM, HTML->PDF, notifications)
ABACUSAI_API_KEY=""
WEB_APP_ID=""
NOTIF_ID_CONTACT_ENQUIRY_SUBMISSION=""

# Machine-to-machine ingest key (BioVeracity Scout / Grok Bot)
BIOVERACITY_INGEST_KEY=""

# Bootstrap/demo admin account (used ONLY by scripts/seed.ts).
# If unset, the demo seed will NOT create an admin account.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Private workspaces and case evidence: default OFF; enable only in an approved runtime.
PRIVATE_WORKSPACES_ENABLED="false"
PRIVATE_EVIDENCE_ENABLED="false"
# Deployment review must cover scanner, isolation, quotas, telemetry, DB and key custody.
PRIVATE_EVIDENCE_RUNTIME_APPROVED="false"
# 64 hexadecimal characters (32 random bytes), held in the deployment secret manager.
# Keep this key recoverable alongside encrypted backups; do not change it casually.
PRIVATE_EVIDENCE_KEY=""

# Legacy external PDF service remains disabled for private evidence.
PUBLIC_PDF_EXTERNAL_PROCESSING_ENABLED="false"
PDF_JOB_ENCRYPTION_KEY=""
