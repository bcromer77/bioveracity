# BioVeracity environment template — copy to .env and fill in real values locally.
# NEVER commit the real .env (it is gitignored).

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# Abacus.AI platform APIs (LLM, HTML->PDF, notifications)
ABACUSAI_API_KEY=""
WEB_APP_ID=""
NOTIF_ID_CONTACT_ENQUIRY_SUBMISSION=""

# Machine-to-machine ingest key (BioVeracity Scout / Grok Bot)
BIOVERACITY_INGEST_KEY=""

# Reviewed evidence pipeline and registered semantic search (server/worker only).
# Enable only after the additive migrations and staging checks in docs/.
BIOVERACITY_EVIDENCE_ENABLED="false"
BIOVERACITY_EVIDENCE_INGEST_KEY=""
BIOVERACITY_VECTOR_ENABLED="false"
BIOVERACITY_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_API_KEY=""

# Bootstrap/demo admin account (used ONLY by scripts/seed.ts).
# If unset, the demo seed will NOT create an admin account.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
