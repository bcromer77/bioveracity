# BioVeracity environment template — copy to .env and fill in real values locally.
# NEVER commit the real .env (it is gitignored).

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# Google sign-in (optional). The provider is registered server-side ONLY when
# this flag is exactly "true" AND both credentials below are non-empty. When it
# is off, the Google auth route and the Google login/signup buttons are both
# unavailable. Defaults off.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Abacus.AI platform APIs (LLM, HTML->PDF, notifications)
ABACUSAI_API_KEY=""
WEB_APP_ID=""
NOTIF_ID_CONTACT_ENQUIRY_SUBMISSION=""

# Machine-to-machine ingest key (BioVeracity Scout / Grok Bot)
BIOVERACITY_INGEST_KEY=""

# Account recovery (password reset) and transactional email.
# Canonical public origin used to build reset links. NEVER derived from the
# request Host header. Must be an https origin in production.
APP_BASE_URL="https://bioveracity.com"
# Transactional email provider: exactly one of "resend" or "abacus" (no silent
# fallback). 'resend' is preferred in production once the sender domain is
# verified; 'abacus' uses the Abacus.AI notification service.
TRANSACTIONAL_EMAIL_PROVIDER=""
# Verified sender, e.g. "BioVeracity <noreply@bioveracity.com>". Only use the
# bioveracity.com sender once the domain/sender is verified with the provider.
TRANSACTIONAL_EMAIL_FROM=""
# Required when TRANSACTIONAL_EMAIL_PROVIDER=resend.
RESEND_API_KEY=""
# Required when TRANSACTIONAL_EMAIL_PROVIDER=abacus (ABACUSAI_API_KEY and
# WEB_APP_ID above are reused; this is the notification type id).
NOTIF_ID_TRANSACTIONAL_EMAIL=""

# Reviewed evidence pipeline and registered semantic search (server/worker only).
# Enable only after the additive migrations and staging checks in docs/.
BIOVERACITY_EVIDENCE_ENABLED="false"
BIOVERACITY_EVIDENCE_INGEST_KEY=""
OPPORTUNITY_ROUTING_ENABLED="false"
BIOVERACITY_VECTOR_ENABLED="false"
BIOVERACITY_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_API_KEY=""

# Bootstrap/demo admin account (used ONLY by scripts/seed.ts).
# If unset, the demo seed will NOT create an admin account.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Private workspaces and case evidence: default OFF; enable only in an approved runtime.
PRIVATE_WORKSPACES_ENABLED="false"
PRIVATE_EVIDENCE_ENABLED="false"
# Deployment review must cover scanner, isolation, quotas, telemetry, DB and key custody.
PRIVATE_EVIDENCE_RUNTIME_APPROVED="false"
# 64 hexadecimal characters (32 random bytes), held in the deployment secret manager.
# Keep this key recoverable alongside encrypted backups; do not change it casually.
PRIVATE_EVIDENCE_KEY=""
CLOUDMERSIVE_API_KEY=""

# Private Ellona workspace. Keep disabled until the migration, sender-domain
# checks, internal email/PDF review and explicit customer activation approval.
ELLONA_WATCH_ENABLED="false"

# Legacy external PDF service remains disabled for private evidence.
PUBLIC_PDF_EXTERNAL_PROCESSING_ENABLED="false"
PDF_JOB_ENCRYPTION_KEY=""


# Stripe billing. Keep billing disabled until test-mode products, webhook signing
# and hosted acceptance are complete. Live charging requires an additional gate.
BIOVERACITY_BILLING_ENABLED="false"
BIOVERACITY_BILLING_LIVE_ALLOWED="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_API_VERSION=""
STRIPE_WILD_MONTHLY_PRICE_ID=""
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=""
STRIPE_WILD_SELF_SERVE_ENABLED="false"
STRIPE_PROFESSIONAL_SELF_SERVE_ENABLED="false"

# Venue photo journal: deploy migration and verify the hosted journey before enabling.
WILD_PHOTO_JOURNAL_ENABLED=false
# Separate outbound gate. Schedule photos:weekly on Mondays at 09:00 UTC.
WILD_PHOTO_DIGEST_SEND_ENABLED=false

# Enable after 20260924_data_rights migration, legal and operator acceptance.
DATA_RIGHTS_ENABLED=false

# Production readiness: enable identity enforcement after migration and email delivery checks.
AUTH_REQUIRE_VERIFIED_EMAIL=false
AUTH_ADMIN_EMAIL_STEP_UP=false
# Enable ONLY after the reverse proxy strips/replaces incoming forwarding headers.
AUTH_TRUST_PROXY_IP=false
# Server gate additional to NEXT_PUBLIC_ASK_ENABLED. Quotas: 10/user/hour, 100/deployment/day.
ASK_SERVER_ENABLED=false
# The existing implementation supports Stripe. Revolut is not an integrated provider.
BILLING_PROVIDER=stripe
# Daily privacy queue reminders and response notifications. Configure operator and deputy.
OPERATIONS_SEND_ENABLED=false
PRIVACY_OPERATOR_EMAIL=
PRIVACY_DEPUTY_EMAIL=
# Random secret, minimum 32 characters, held by authenticated uptime monitor.
OPERATIONS_MONITOR_TOKEN=
