# Configure through hosting secret settings, never commit real credentials.
# Generate INGEST_CRON_SECRET with: openssl rand -hex 32
INGEST_CRON_SECRET=
SCOTLAND_INGEST_ENABLED=false
SCOTLAND_INGEST_WRITE_ENABLED=false
# Comma-separated source IDs ONLY after acquisition permission review.
# Without approval, receiveEvidence retains catalogue references, not raw features.
SCOTLAND_ACQUISITION_APPROVED=
# Existing evidence intake must also be enabled before writes are accepted.
# BIOVERACITY_EVIDENCE_ENABLED remains managed by the existing deployment process.
