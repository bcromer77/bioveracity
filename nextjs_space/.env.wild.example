# HTTPS public origin only. Set after verifying the intended deployed site.
# Example codes remain labelled concepts; do not manufacture live partner signs yet.
WILD_PUBLIC_ORIGIN=https://your-confirmed-domain.example
# Enquiry storage and notification reuse the app's existing configured database
# and notification credentials. Never commit actual keys.

# Self-service ecology hubs. Enable only after the additive WildHub migration
# and a successful isolated owner/public/QR/photo smoke test. Defaults to off.
WILD_HUBS_ENABLED=false
# Uses existing DATABASE_URL, auth and CLOUDMERSIVE_API_KEY.
# Photo uploads fail closed when scanning is unavailable; do not add bypasses.
