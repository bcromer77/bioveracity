generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/bioveracity/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Additive evidence pipeline. Source content is private; only reviewed claims
// are exposed to registered users through evidence search.
model EvidenceDocument {
  id              String   @id @default(cuid())
  documentKey     String
  versionHash     String   @unique
  observedAt      DateTime
  createdAt       DateTime @default(now())
  url             String
  title           String
  publisher       String
  authorityId     String
  jurisdiction    String
  eventDate       String?
  eventPrecision  String
  publicationDate String?
  contentKind     String
  sections        Json
  status          String   @default("PENDING_REVIEW")
  activeReviewId  String?
  // Biodiversity safeguards. Authoritative server-side classification; never set
  // from an incoming feed flag. Defaults keep new records out of ordinary search,
  // export and embedding until a reviewer classifies them.
  sensitivity        String  @default("UNKNOWN") // UNKNOWN | PUBLIC | RESTRICTED
  reusePermission    String  @default("UNKNOWN") // UNKNOWN | PERMITTED | PROHIBITED | CATALOGUE_ONLY
  incomingSensitivity String?                    // preserved incoming warning, audit only
  catalogueOnly      Boolean @default(false)      // minimal catalogue reference; underlying dataset not retained
  sourceRegisterId   String?
  sourceRegister     EvidenceSourceRegister? @relation(fields: [sourceRegisterId], references: [id])
  reviews         EvidenceReview[]

  @@index([documentKey, observedAt])
  @@index([authorityId])
  @@index([sensitivity, reusePermission])
  @@index([sourceRegisterId])
}

// Approved source / dataset register (biodiversity control #3). One row per
// approved dataset: publisher, identifier, licence terms, required attribution,
// permitted uses, commercial conditions, spatial resolution and any specific
// permissions. Documents reference this to carry licence and attribution into
// results, APIs and reports.
model EvidenceSourceRegister {
  id                     String   @id @default(cuid())
  publisher              String
  datasetIdentifier      String
  licence                String
  licenceVersion         String?
  link                   String?
  requiredAttribution    String
  permittedUses          String
  commercialUseConditions String?
  spatialResolution      String?
  specificPermissions    String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  documents             EvidenceDocument[]

  @@unique([publisher, datasetIdentifier])
}

model EvidenceReview {
  id           String   @id @default(cuid())
  documentId   String
  document     EvidenceDocument @relation(fields: [documentId], references: [id])
  reviewer     String
  claim        String
  excerpt      String
  locator      String
  basis        String
  evidenceType String
  createdAt    DateTime @default(now())
  embeddings   EvidenceEmbedding[]
  @@index([documentId])
}

model EvidenceEmbedding {
  reviewId  String
  review    EvidenceReview @relation(fields: [reviewId], references: [id])
  space     String
  embedding Unsupported("vector(1536)")
  createdAt DateTime @default(now())
  @@id([reviewId, space])
}

model EvidenceSearchQuota {
  userId   String @id
  window   DateTime
  requests Int
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String      @default("user")
  privateMemberships PrivateWorkspaceMember[]
  privateAudit PrivateWorkspaceAudit[]
  caseDocuments PrivateCaseDocument[] @relation("CaseDocumentImporter")
  caseReviews PrivateCaseEventRevision[] @relation("CaseEventReviewer")
  caseExports PrivateCaseExport[] @relation("CaseExportRequester")
  accounts      Account[]
  sessions      Session[]
  watchlists    Watchlist[]
  leads         Lead[]
  watches       Watch[]
  accessState   String      @default("REGISTERED") // REGISTERED, DEMO, INSTITUTIONAL, ADMIN
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Asset {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  type                String // port, wastewater, river, lake, industrial
  subtype             String? // container_terminal, wrc, wwtw, etc.
  region              String // irish_ports, cambridgeshire, scotland, northern_ireland
  regionSlug          String
  status              String               @default("active") // active, monitoring, construction, planning
  statusDetail        String?
  latitude            Float?
  longitude           Float?
  summary             String?
  description         String?
  operatorName        String?
  regulatorName       String?
  jurisdiction        String?
  imageUrl            String?
  priorityScore       Int                  @default(0)
  events              Event[]
  authorisations      Authorisation[]
  capitalProjects     CapitalProject[]
  regulatoryItems     RegulatoryActivity[]
  measurements        Measurement[]
  communityItems      CommunityReport[]
  newsItems           NewsItem[]
  evidenceGaps        EvidenceGap[]
  divergences         Divergence[]
  watchlists          Watchlist[]
  leads               Lead[]
  // Phase 1 canonical architecture (additive)
  assetIdentifiers    AssetIdentifier[]
  assetAliases        AssetAlias[]
  assetAreas          AssetArea[]
  relationsFrom       AssetRelation[]      @relation("FromAsset")
  relationsTo         AssetRelation[]      @relation("ToAsset")
  changeRecords       ChangeRecord[]
  unresolvedQuestions UnresolvedQuestion[]
  watches             Watch[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([region])
  @@index([type])
  @@index([slug])
}

model Event {
  id            String    @id @default(cuid())
  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  date          DateTime
  endDate       DateTime?
  eventType     String // regulatory, operational, environmental, planning, community, construction
  evidenceClass String // R, P, G, O, C, M, A
  severity      String? // critical, high, medium, low, info
  changeType    String    @default("event") // event, material_change, divergence, corroboration, gap
  datePrecision String    @default("day") // day, month, year — honest temporal precision of `date`
  sourceUrl     String?
  sourceDomain  String?
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([assetId])
  @@index([date])
}

model Divergence {
  id               String   @id @default(cuid())
  assetId          String
  asset            Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title            String   @default("The evidence starts to disagree here")
  date             DateTime
  summary          String?
  before           String // what the evidence showed before
  theChange        String // what changed
  theDifference    String // where the evidence disagrees
  whatHappenedNext String? // subsequent developments
  status           String   @default("unresolved") // unresolved, partially_resolved, resolved
  sourceUrl        String?
  sourceDomain     String?
  createdAt        DateTime @default(now())

  @@index([assetId])
  @@index([date])
}

model Authorisation {
  id            String    @id @default(cuid())
  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  permitRef     String?
  type          String // environmental_permit, planning_permission, dumping_at_sea, mac, discharge_consent
  grantedDate   DateTime?
  expiryDate    DateTime?
  status        String    @default("active") // active, expired, under_review, revoked
  authority     String?
  conditions    String?
  description   String?
  sourceUrl     String?
  evidenceClass String    @default("R")
  createdAt     DateTime  @default(now())

  @@index([assetId])
}

model CapitalProject {
  id            String    @id @default(cuid())
  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  value         String? // e.g. "€38.4 million"
  status        String    @default("planned") // planned, approved, construction, completed, cancelled
  startDate     DateTime?
  endDate       DateTime?
  contractor    String?
  proofRequired String?
  sourceUrl     String?
  evidenceClass String    @default("O")
  createdAt     DateTime  @default(now())

  @@index([assetId])
}

model RegulatoryActivity {
  id            String    @id @default(cuid())
  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  date          DateTime?
  regulator     String?
  type          String // inspection, enforcement, permit_variation, consultation, investigation
  outcome       String?
  sourceUrl     String?
  evidenceClass String    @default("R")
  createdAt     DateTime  @default(now())

  @@index([assetId])
}

model Measurement {
  id            String   @id @default(cuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  parameter     String // phosphorus, dissolved_oxygen, turbidity, phycocyanin, etc.
  value         Float?
  unit          String?
  date          DateTime
  station       String?
  validated     Boolean  @default(false)
  sourceUrl     String?
  evidenceClass String   @default("R")
  createdAt     DateTime @default(now())

  @@index([assetId])
  @@index([date])
}

model CommunityReport {
  id            String    @id @default(cuid())
  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  date          DateTime?
  reportedBy    String? // residents, campaigners, elected_representatives
  type          String // odour, noise, traffic, spillage, visual, health
  corroborated  Boolean   @default(false)
  sourceUrl     String?
  evidenceClass String    @default("C")
  createdAt     DateTime  @default(now())

  @@index([assetId])
}

model NewsItem {
  id            String   @id @default(cuid())
  assetId       String?
  asset         Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title         String
  summary       String?
  date          DateTime
  sourceDomain  String?
  sourceUrl     String?
  region        String?
  category      String? // ports, wastewater, water, industrial, regulation
  evidenceClass String   @default("M")
  createdAt     DateTime @default(now())

  @@index([assetId])
  @@index([date])
}

model EvidenceGap {
  id           String   @id @default(cuid())
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  description  String
  consequence  String?
  dataRequired String?
  priority     String   @default("medium") // critical, high, medium, low
  status       String   @default("open") // open, partially_resolved, resolved
  createdAt    DateTime @default(now())

  @@index([assetId])
}

model Watchlist {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  email      String?
  alertTypes String   @default("all") // all, regulatory, events, news
  reason     String? // why this place matters to the user
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([assetId])
}

model Lead {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId         String?
  asset           Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  name            String
  email           String
  organisation    String?
  role            String?
  assetName       String?
  issue           String
  disputed        String?
  decisionMatters String?
  orgsInvolved    String?
  status          String   @default("new") // new, reviewing, active, resolved
  createdAt       DateTime @default(now())

  @@index([status])
}

model Question {
  id        String   @id @default(cuid())
  question  String
  answer    String?
  assetId   String?
  region    String?
  askedBy   String?
  status    String   @default("answered") // pending, answered, failed
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ==========================================================================
// Direct machine-to-machine ingest (BioVeracity Scout / Grok Bot, schema 2.1)
// Raw-first: the complete incoming JSON is stored before any interpretation.
// Incoming records are CANDIDATES/PROPOSALS only — never auto-published.
// ==========================================================================

model RawIngest {
  id                    String                 @id @default(cuid())
  sourceAgent           String?
  schemaVersion         String?
  category              String?
  targetRegion          String?
  demoTag               String?
  stream                String?
  receivedAt            DateTime               @default(now())
  rawPayload            Json
  analysis              Json? // analysis proposals — never auto-published
  payloadFingerprint    String                 @unique
  observationCount      Int                    @default(0)
  duplicateHits         Int                    @default(0)
  // Pipeline: FOUND, PARSED, VERIFICATION_PENDING, VERIFIED, NORMALISED, PUBLISHED, FAILED
  status                String                 @default("FOUND")
  error                 String?
  // Per-state timestamps
  foundAt               DateTime?
  parsedAt              DateTime?
  verificationPendingAt DateTime?
  verifiedAt            DateTime?
  normalisedAt          DateTime?
  publishedAt           DateTime?
  failedAt              DateTime?
  observations          ObservationCandidate[]
  commercialSignals     CommercialSignal[]
  entityCandidates      EntityCandidate[]
  createdAt             DateTime               @default(now())

  @@index([status])
  @@index([demoTag])
  @@index([targetRegion])
  @@index([receivedAt])
}

model ObservationCandidate {
  id                           String    @id @default(cuid())
  rawIngestId                  String
  rawIngest                    RawIngest @relation(fields: [rawIngestId], references: [id], onDelete: Cascade)
  candidateType                String? // e.g. VERIFIED_RECORD_CANDIDATE, EDM_COUNTY_LEVEL_TOTAL
  observationType              String? // free-form incoming type/label
  title                        String?
  description                  String?
  // Proposals — NOT canonical until verified
  coordinatesProposalLat       Float?
  coordinatesProposalLng       Float?
  confidenceProposal           String? // workflow metadata only
  // EDM_COUNTY_LEVEL_TOTAL structured metrics (stored, never interpreted as damage)
  metricAssetsInCa             Int?
  metricWithSpillCount         Int?
  metricSumSpills              Int?
  metricSumDurationHoursParsed Float?
  reportingYear                Int?
  geoFilteringMethodology      String?
  datasetIdentifier            String?
  jurisdiction                 String?
  sourceUrl                    String?
  publishedAt                  DateTime?
  retrievedAt                  DateTime?
  demoTag                      String?
  // Entity resolution outcome
  resolvedAssetId              String?
  resolutionStatus             String    @default("UNRESOLVED") // RESOLVED, UNRESOLVED
  // Candidate lifecycle (Phase 2): CANDIDATE, NEEDS_REVIEW, VERIFIED, NORMALISED, PUBLISHED, REJECTED
  status                       String    @default("CANDIDATE")
  // Verification gate (§L) — how the record was verified against a trusted source
  verificationMethod           String? // DETERMINISTIC_IDENTIFIER, DETERMINISTIC_SOURCE, HUMAN_REVIEW
  verificationNote             String?
  reviewedBy                   String?
  verifiedAt                   DateTime?
  rejectedAt                   DateTime?
  rejectionReason              String?
  // Normalisation (§O) — computed canonical shape, then committed at publish
  normalisedTargetType         String? // Measurement, Authorisation, RegulatoryActivity, CapitalProject, CommunityReport, NewsItem, Event, AssetIdentifier, DatasetCoverage
  normalisedPayload            Json? // computed canonical payload (not yet public)
  normalisedRecordType         String? // canonical table a published record was written to
  normalisedRecordId           String? // id of the committed public record
  normalisedAt                 DateTime?
  lifecyclePublishedAt         DateTime?
  rawObservation               Json
  createdAt                    DateTime  @default(now())

  @@index([rawIngestId])
  @@index([candidateType])
  @@index([resolutionStatus])
  @@index([status])
}

model CommercialSignal {
  id                       String    @id @default(cuid())
  rawIngestId              String
  rawIngest                RawIngest @relation(fields: [rawIngestId], references: [id], onDelete: Cascade)
  possibleBuyer            String?
  commercialOpportunity    String?
  sensorOpportunity        String?
  proofOfEffectOpportunity String?
  rawCommercial            Json
  createdAt                DateTime  @default(now())

  @@index([rawIngestId])
}

model EntityCandidate {
  id                 String    @id @default(cuid())
  rawIngestId        String
  rawIngest          RawIngest @relation(fields: [rawIngestId], references: [id], onDelete: Cascade)
  proposedType       String? // Asset, Region, Organisation, WaterBody, Catchment, WastewaterAsset
  officialIdentifier String?
  canonicalName      String?
  aliases            String? // comma-separated / JSON string of aliases
  jurisdiction       String?
  matchedAssetId     String?
  resolutionStatus   String    @default("UNRESOLVED") // RESOLVED, UNRESOLVED
  rawProposal        Json
  createdAt          DateTime  @default(now())

  @@index([rawIngestId])
  @@index([resolutionStatus])
}

// ==========================================================================
// PHASE 1 — Canonical identity, geography, relationship graph, provenance,
// dataset coverage, change/uncertainty engine, and generic watch model.
// All additive; existing tables untouched. `sourceDocumentId` fields are soft
// references (indexed String) to SourceDocument for forward-compatibility.
// PostGIS is deferred: geometry is stored as optional WKT text for now.
// ==========================================================================

// I. Source document — first-class provenance object.
model SourceDocument {
  id                 String    @id @default(cuid())
  publisher          String?
  title              String?
  url                String?
  documentIdentifier String?
  documentType       String?
  publicationDate    DateTime?
  eventDate          DateTime?
  retrievalDate      DateTime  @default(now())
  jurisdiction       String?
  sourceTier         String?
  rawIngestId        String?
  metadata           Json?
  contentHash        String?
  createdAt          DateTime  @default(now())

  @@index([publisher])
  @@index([documentIdentifier])
  @@index([rawIngestId])
  @@index([contentHash])
}

// D. Canonical identity — official identifiers per authority.
model AssetIdentifier {
  id               String    @id @default(cuid())
  assetId          String
  asset            Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  authority        String
  identifierType   String
  value            String
  sourceDocumentId String?
  sourceUrl        String?
  verified         Boolean   @default(false)
  validFrom        DateTime?
  validTo          DateTime?
  createdAt        DateTime  @default(now())

  @@unique([authority, identifierType, value])
  @@index([assetId])
  @@index([value])
}

// E. Asset aliases — normalized, unique per asset.
model AssetAlias {
  id                String   @id @default(cuid())
  assetId           String
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  alias             String
  aliasNormalized   String
  sourceDocumentId  String?
  sourceUrl         String?
  verificationState String   @default("UNVERIFIED")
  createdAt         DateTime @default(now())

  @@unique([assetId, aliasNormalized])
  @@index([aliasNormalized])
}

// F. Proper geography — an asset may belong to many overlapping areas.
model Area {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  type                String // COUNTRY, REGION, COUNTY, LOCAL_AUTHORITY, CATCHMENT, OPERATIONAL_CATCHMENT, WFD_WATER_BODY_AREA, MARITIME_AREA, PORT_AREA, COASTAL_AREA, OTHER
  jurisdiction        String?
  officialIdentifier  String?
  parentAreaId        String?
  parentArea          Area?                @relation("AreaHierarchy", fields: [parentAreaId], references: [id], onDelete: SetNull)
  childAreas          Area[]               @relation("AreaHierarchy")
  sourceDocumentId    String?
  geometry            String? // WKT geometry (forward-compatible; PostGIS deferred)
  assetAreas          AssetArea[]
  changeRecords       ChangeRecord[]
  unresolvedQuestions UnresolvedQuestion[]
  watches             Watch[]
  datasetCoverages    DatasetCoverage[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([type])
  @@index([parentAreaId])
}

// F. AssetArea join — many-to-many asset/area membership.
model AssetArea {
  id                String   @id @default(cuid())
  assetId           String
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  areaId            String
  area              Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  relationshipType  String   @default("WITHIN")
  sourceDocumentId  String?
  verificationState String   @default("UNVERIFIED")
  createdAt         DateTime @default(now())

  @@unique([assetId, areaId, relationshipType])
  @@index([assetId])
  @@index([areaId])
}

// H. Relationship graph — directional, source-backed edges only.
model AssetRelation {
  id                String    @id @default(cuid())
  fromAssetId       String
  fromAsset         Asset     @relation("FromAsset", fields: [fromAssetId], references: [id], onDelete: Cascade)
  toAssetId         String
  toAsset           Asset     @relation("ToAsset", fields: [toAssetId], references: [id], onDelete: Cascade)
  relationshipType  String // DISCHARGES_TO, RECEIVES_FROM, UPSTREAM_OF, DOWNSTREAM_OF, FLOWS_INTO, WITHIN_CATCHMENT, MONITORED_BY, SERVES, PART_OF, ADJACENT_TO, AFFECTED_BY_PROJECT, REGULATED_BY, OPERATED_BY
  sourceDocumentId  String?
  sourceUrl         String?
  verificationState String    @default("UNVERIFIED")
  validFrom         DateTime?
  validTo           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([fromAssetId, relationshipType])
  @@index([toAssetId, relationshipType])
}

// J. Dataset coverage — false-gap control (processing state != absence).
model DatasetCoverage {
  id                String   @id @default(cuid())
  datasetName       String
  publisher         String?
  jurisdiction      String?
  areaId            String?
  area              Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  reportingPeriod   String?
  sourceUrl         String?
  status            String   @default("DISCOVERED") // DISCOVERED, AVAILABLE, PROCESSING, PROCESSED, PARTIAL, COMPLETE, NOT_APPLICABLE, FAILED
  recordsAvailable  Int?
  recordsProcessed  Int?
  recordsNormalised Int?
  recordsLinked     Int?
  recordsUnresolved Int?
  methodology       String?
  lastCheckedAt     DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([areaId])
}

// P. Change engine — the heart of follow / alerting.
model ChangeRecord {
  id                   String    @id @default(cuid())
  assetId              String?
  asset                Asset?    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  areaId               String?
  area                 Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  sourceDocumentId     String?
  changeType           String // RECORD_ADDED, MATERIAL_CHANGE, UNCERTAINTY_REDUCED, UNCERTAINTY_INCREASED, GAP_RESOLVED, NEW_UNRESOLVED_QUESTION, EVIDENCE_DIVERGENCE, RESOLUTION_PATH_IDENTIFIED, INTERVENTION_RECORDED, DECISION_OR_DEADLINE_CHANGED
  title                String
  description          String?
  eventDate            DateTime?
  detectedAt           DateTime  @default(now())
  materialityState     String    @default("IMMATERIAL") // internal qualitative state only
  previousState        Json?
  newState             Json?
  resolutionQuestionId String?
  published            Boolean   @default(false)
  createdAt            DateTime  @default(now())

  @@index([assetId])
  @@index([areaId])
  @@index([changeType])
  @@index([published])
}

// R. Unresolved question — the practical representation of residual uncertainty.
model UnresolvedQuestion {
  id                  String           @id @default(cuid())
  assetId             String?
  asset               Asset?           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  areaId              String?
  area                Area?            @relation(fields: [areaId], references: [id], onDelete: SetNull)
  title               String
  question            String
  status              String           @default("OPEN") // OPEN, PARTIALLY_RESOLVED, RESOLVED, CLOSED_NOT_RESOLVABLE
  materialityInternal String?
  openedAt            DateTime         @default(now())
  resolvedAt          DateTime?
  resolutionSummary   String?
  resolutionPaths     ResolutionPath[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([assetId])
  @@index([areaId])
  @@index([status])
}

// S. Resolution path — what evidence would help answer an open question.
model ResolutionPath {
  id                   String             @id @default(cuid())
  unresolvedQuestionId String
  unresolvedQuestion   UnresolvedQuestion @relation(fields: [unresolvedQuestionId], references: [id], onDelete: Cascade)
  evidenceType         String // DOCUMENT, REGULATORY_RECORD, OPERATOR_RECORD, LAB_SAMPLE, SITE_VISIT, UPSTREAM_DOWNSTREAM_SAMPLING, CONTINUOUS_SENSOR, SATELLITE, WEATHER_CONTEXT, LONGER_TIME_SERIES, SOURCE_SIGNATURE, OTHER
  description          String
  priorityInternal     String?
  estimatedCost        String?
  estimatedDuration    String?
  supplierCategory     String?
  status               String             @default("IDENTIFIED")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([unresolvedQuestionId])
}

// U. Generic watch/follow — asset, area, catchment or portfolio.
model Watch {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType  String // ASSET, AREA, CATCHMENT, PORTFOLIO
  assetId     String?
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  areaId      String?
  area        Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  portfolioId String?
  email       String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([assetId])
  @@index([areaId])
  @@index([targetType])
}

model PrivateWorkspace {
  id String @id
  name String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  members PrivateWorkspaceMember[]
  cases PrivateCase[]
  audit PrivateWorkspaceAudit[]
}
model PrivateWorkspaceMember {
  workspaceId String
  userId String
  role String
  revokedAt DateTime? @db.Timestamptz(3)
  workspace PrivateWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  cases PrivateCaseMember[]
  @@id([workspaceId, userId])
  @@index([userId, revokedAt])
}
model PrivateCase {
  id String @id
  workspaceId String
  title String
  template String @default("GENERAL")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  workspace PrivateWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  members PrivateCaseMember[]
  sites PrivateCaseSite[]
  audit PrivateWorkspaceAudit[]
  documents PrivateCaseDocument[]
  exports PrivateCaseExport[]
  @@unique([workspaceId, id])
}

model PrivateCaseDocument {
  id String @id
  workspaceId String
  caseId String
  name String
  hash String
  encryptedBytes Bytes
  byteLength Int
  mediaType String
  status String
  metadata Json @default("{}")
  warnings Json @default("[]")
  parentId String?
  supersedesId String?
  sourceUrl String?
  publicationDate String?
  parserVersion String
  importedBy String
  importedAt DateTime @default(now()) @db.Timestamptz(3)
  case PrivateCase @relation(fields: [workspaceId, caseId], references: [workspaceId, id], onDelete: Restrict)
  importer User @relation("CaseDocumentImporter", fields: [importedBy], references: [id], onDelete: Restrict)
  parent PrivateCaseDocument? @relation("EmailAttachments", fields: [workspaceId, caseId, parentId], references: [workspaceId, caseId, id], onDelete: NoAction, onUpdate: NoAction)
  children PrivateCaseDocument[] @relation("EmailAttachments")
  supersedes PrivateCaseDocument? @relation("CaseDocumentVersions", fields: [workspaceId, caseId, supersedesId], references: [workspaceId, caseId, id], onDelete: NoAction, onUpdate: NoAction)
  amendments PrivateCaseDocument[] @relation("CaseDocumentVersions")
  passages PrivateCasePassage[]
  @@unique([workspaceId, caseId, id])
  @@unique([workspaceId, caseId, hash])
}
model PrivateCasePassage {
  id String @id
  workspaceId String
  caseId String
  documentId String
  ordinal Int
  locator String
  text String
  document PrivateCaseDocument @relation(fields: [workspaceId, caseId, documentId], references: [workspaceId, caseId, id], onDelete: Restrict)
  events PrivateCaseEvent[]
  @@unique([workspaceId, caseId, id])
  @@index([workspaceId, caseId, documentId])
}
model PrivateCaseEvent {
  id String @id
  workspaceId String
  caseId String
  passageId String
  passage PrivateCasePassage @relation(fields: [workspaceId, caseId, passageId], references: [workspaceId, caseId, id], onDelete: Restrict)
  revisions PrivateCaseEventRevision[]
  @@unique([workspaceId, caseId, id])
  @@index([workspaceId, caseId])
}
model PrivateCaseEventRevision {
  eventId String
  revision Int
  title String
  quote String
  eventDate String?
  precision String
  status String
  evidenceType String @default("SOURCE_STATEMENT")
  note String @default("")
  reviewedBy String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  event PrivateCaseEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  reviewer User? @relation("CaseEventReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  @@id([eventId, revision])
}
model PrivateCaseExport {
  id String @id
  workspaceId String
  caseId String
  requestedBy String
  encryptedBytes Bytes
  hash String
  manifest Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  case PrivateCase @relation(fields: [workspaceId, caseId], references: [workspaceId, id], onDelete: Restrict)
  requester User @relation("CaseExportRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  @@index([workspaceId, caseId, requestedBy])
}
model PrivateCaseMember {
  workspaceId String
  caseId String
  userId String
  role String
  canExport Boolean @default(false)
  revokedAt DateTime? @db.Timestamptz(3)
  case PrivateCase @relation(fields: [workspaceId, caseId], references: [workspaceId, id], onDelete: Restrict)
  member PrivateWorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Restrict)
  @@id([workspaceId, caseId, userId])
  @@index([userId, revokedAt])
}
model PrivateCaseSite {
  id String @id
  workspaceId String
  caseId String
  name String
  latitude Float?
  longitude Float?
  case PrivateCase @relation(fields: [workspaceId, caseId], references: [workspaceId, id], onDelete: Restrict)
  @@index([workspaceId, caseId])
}
model PrivateWorkspaceAudit {
  id String @id
  workspaceId String
  caseId String?
  actorId String
  action String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  workspace PrivateWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  case PrivateCase? @relation(fields: [workspaceId, caseId], references: [workspaceId, id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([workspaceId, createdAt])
}
