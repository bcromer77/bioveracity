# Configure through runtime secret settings; never commit real values.
BIOVERACITY_STATE_DIR=/var/lib/bioveracity
BIOVERACITY_SOURCE_CONFIG=/absolute/path/to/repo/collectors/pilot-sources.json
BIOVERACITY_EVIDENCE_ENDPOINT=https://bioveracity.com/api/ingest/evidence
BIOVERACITY_EVIDENCE_INGEST_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# On the Next.js server only, enable after migration and staging tests:
BIOVERACITY_EVIDENCE_ENABLED=false
